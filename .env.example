# ========================================================
# Database Configuration for Hatyaiwittayalai School Timetable
# รองรับทั้ง Local SQLite และ Cloud PostgreSQL (Neon / Supabase / Vercel Postgres)
# ========================================================

# พอร์ตสำหรับรัน Express Server (Default: 3000)
PORT=3000

# หากต้องการเชื่อมต่อฐานข้อมูล Cloud จริงบน Vercel (PostgreSQL / Neon / Supabase):
# ใส่ Connection String ที่ได้จาก Neon.tech หรือ Supabase.com
# ตัวอย่าง:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-sweet-snow-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# หรือถ้าใช้ Vercel Postgres / Supabase:
# POSTGRES_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
